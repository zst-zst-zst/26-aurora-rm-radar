# ============================================================
# 红方外参备份 (Red-side extrinsics backup)
# ============================================================
# 来源: 从蓝方备份通过 180° 场地对称推算
# 相机裁判系位置: x=-1.26  y=5.02  z=3.75m
#   (基座 2.5m + 支架到相机中心 1.25m)
# 相机姿态: pitch≈-1.8° (基本水平)
#
# 如果比赛标定失误, 复制下面内容覆盖 out_matrix_red.yaml:
#   cp config/red/out_matrix_red.yaml.backup config/red/out_matrix_red.yaml
#
# 注意: 假设红蓝雷达站对称架设, 相机基本水平。
#       实际标定精度更高, 此文件仅作应急保底。
# ============================================================
%YAML:1.0
---
world_rvec: !!opencv-matrix
   rows: 3
   cols: 1
   dt: d
   data: [ 1.4819006711782274e+00, -1.2900459912465041e+00,
       1.0256198014393576e+00 ]
world_tvec: !!opencv-matrix
   rows: 3
   cols: 1
   dt: d
   data: [ -9.8842128025102767e+00, 2.7131332902420651e+00,
       3.2005262664496810e+00 ]
