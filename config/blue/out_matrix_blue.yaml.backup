# ============================================================
# 蓝方外参备份 (Blue-side extrinsics backup)
# ============================================================
# 来源: 从已验证外参调整高度至实际安装高度
# 相机裁判系位置: x=29.26  y=9.98  z=3.75m
#   (基座 2.5m + 支架到相机中心 1.25m)
# 相机姿态: pitch≈-1.8° (基本水平)
#
# 如果比赛标定失误, 复制下面内容覆盖 out_matrix_blue.yaml:
#   cp config/blue/out_matrix_blue.yaml.backup config/blue/out_matrix_blue.yaml
#
# 注意: 假设雷达站在标准位置, 相机基本水平。
#       实际标定精度更高, 此文件仅作应急保底。
# ============================================================
%YAML:1.0
---
world_rvec: !!opencv-matrix
   rows: 3
   cols: 1
   dt: d
   data: [ 1.3091151740417071e+00, 1.5038058086498975e+00,
       -1.1216847873709752e+00 ]
world_tvec: !!opencv-matrix
   rows: 3
   cols: 1
   dt: d
   data: [ 8.2133515164449289e+00, -3.5051184461741198e+00,
       2.8554254021236275e+01 ]
